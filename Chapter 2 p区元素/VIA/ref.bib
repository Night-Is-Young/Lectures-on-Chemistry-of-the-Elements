@article{Volnov1967,
    author    = {Vol'nov, I. I. and Chamova, V. N. and Latysheva, E. I.},
    title     = {On the mechanism of the formation of ozonides of the alkali metals},
    journal   = {Bulletin of the Academy of Sciences of the USSR, Division of chemical science},
    year      = {1967},
    date      = {1967-06-01},
    volume    = {16},
    number    = {6},
    pages     = {1147--1150},
    doi       = {10.1007/BF00908262},
    url       = {https://doi.org/10.1007/BF00908262},
    issn      = {1573-9171},
    abstract  = {A mechanism of the formation of ozonides of alkali metals was proposed on the basis of data obtained in an investigation of the reaction of oxygen-labeled KOH with ozone, the reaction of KOH with atomic oxygen, and the reaction of KOH with ozone; this mechanism is based upon: the catalytic decomposition of ozone on the surface of the solid alkalies into molecular and atomic oxygen, the interaction of the latter with the hydroxide, forming a superperoxide, and an interaction of the superperoxide with ozone, forming the ozonide.}
}

